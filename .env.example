# ── sela license server v3 ──────────────────────────────────────
# Copy to .env (Coolify: set these in the app's Environment editor).

# Port inside the container (Coolify maps it automatically).
PORT=3000

# SQLite + generated keys live here — mount a persistent volume.
DATA_DIR=/data

# ── Secret admin panel path (v3) ─────────────────────────────────
# The admin panel is ONLY reachable at /{ADMIN_PATH_SECRET} — every
# other path returns 404. 6-64 chars [A-Za-z0-9_-].
# If not set, a random path is generated once (stored in the DB) and
# logged to the container logs on first boot.
# Example: with the value below the panel URL becomes:
#   https://your-domain/sela-panel-x7k9m2
ADMIN_PATH_SECRET=

# ── Panel login (email + password) ───────────────────────────────
# On FIRST boot with an empty database the server creates the owner
# account from these values. Change the password from the panel later.
ADMIN_EMAIL=abdala2656289@gmail.com
ADMIN_PASSWORD=Aa450@#$

# Optional master token — works as a root bearer for the admin API
# in addition to email/password accounts. Leave empty to disable.
ADMIN_TOKEN=

# Ed25519 PRIVATE key (PKCS8 DER hex) that signs licenses.
# The matching PUBLIC key is baked inside the sela Android app:
#   6ee513c1b7f0b057d970c6c2f4b33e5d026bc4c798b5a0b8bb72818d3197d103
# Do NOT change unless you also rebuild the app with the new key.
LICENSE_SIGNING_PRIVATE_KEY=302e020100300506032b6570042204208960d794fa492558c0364af79f0d51c88abc4b20b24cc854f60221116924bd93

# Local timezone for reports/statistics (revenue by month etc).
TZ=Asia/Jerusalem

# Management contact info shown inside the app (editable from the
# admin panel too — this is just the first-boot default).
CONTACT_PHONE=+972 59 000 0000
CONTACT_WHATSAPP=+972 59 000 0000
CONTACT_TELEGRAM=
CONTACT_EMAIL=abdalasela@gmail.com
CONTACT_NOTE=لشراء أو تجديد الاشتراك تواصل معنا عبر أحد قنوات التواصل
